# downstream/Dockerfile.downstream — Overlay for downstream-specific image
# customizations on top of the upstream base image.
#
# Build the upstream image first, then build this FROM it:
#   podman build --tag openclaw:base -f Dockerfile .
#   podman build --tag openclaw:final -f downstream/Dockerfile.downstream \
#     --build-arg BASE_IMAGE=openclaw:base .
#
# History:
#   On upstream <= v2026.4.29, this overlay baked bundled plugin runtime deps
#   into the image via `plugins deps --repair` to avoid runtime pnpm installs.
#   As of upstream main (ed8f50f240, 2026-05-01), the runtime dep install
#   machinery was removed entirely — runtime loading no longer runs package
#   managers. The overlay is now a no-op passthrough but retained as the
#   extension point for future downstream image customizations.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# USER node, WORKDIR /app, ENV, HEALTHCHECK, CMD all inherited from base.
# No additional build steps needed on post-refactor upstream bases.
